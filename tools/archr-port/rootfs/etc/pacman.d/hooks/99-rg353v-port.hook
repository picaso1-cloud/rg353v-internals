[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = archr
Target = archr-launcher
Target = archr-joypad
Target = autostart
Target = quirks
Target = system-utils
Target = archr-hotkey
Target = powerstate
Target = sleep
Target = retroarch

[Action]
Description = RG353V port: re-apply the patches the packages overwrite
When = PostTransaction
Exec = /usr/local/bin/rg353v-port-doctor
