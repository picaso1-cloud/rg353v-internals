[Unit]
Description=DHCP client on wlan0
After=wpa-wlan0.service
Wants=wpa-wlan0.service
[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do [ -e /sys/class/net/wlan0 ] && break; sleep 1; done'
ExecStart=/usr/sbin/udhcpc -i wlan0 -f -R -t 15 -T 3 -s /usr/local/bin/udhcpc-wlan0.sh
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
