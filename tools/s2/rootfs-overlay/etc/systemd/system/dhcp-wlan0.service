[Unit]
Description=DHCP client on wlan0
# iwd owns the interface (it is what the launcher's Settings page and
# wifictl speak); this unit only asks for the address. It must not pull
# wpa_supplicant in: two managers on one interface fight each other.
After=iwd.service
Wants=iwd.service
[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do [ -e /sys/class/net/wlan0 ] && break; sleep 1; done'
ExecStart=/usr/sbin/udhcpc -i wlan0 -f -R -t 15 -T 3 -s /usr/local/bin/udhcpc-wlan0.sh
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
